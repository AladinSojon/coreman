VITE_API_URL=http://localhost:8080

# Image uploads (admin panel). Left unset for local development so test uploads
# don't go to the live bucket. To enable, create frontend/.env.local with a
# separate Supabase project's values:
# VITE_SUPABASE_URL=https://<your-dev-project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
